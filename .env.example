# equipaps — variables d'environnement de production
# Copier ce fichier en .env pour le dev local (jamais commité).
# En hébergement Coolify, ces valeurs vivent dans les Environment Variables
# de l'application, jamais dans le dépôt.

# Base MySQL (hébergement : ressource MySQL Coolify ; dev : MySQL local)
DB_MYSQL_HOST=localhost
DB_MYSQL_USER=equipaps
DB_MYSQL_DATABASE=equipaps
DB_MYSQL_PASSWORD=

# Secret de signature des jetons de session (élève comme bureau).
# Différent par déploiement : le changer déconnecte tout le monde.
JWT_SECRET=

# Mot de passe partagé du bureau (page /admin). Le serveur en dérive le
# SHA-256 au boot et refuse de démarrer sans lui.
EVENT_PASSWORD=

# Port d'écoute (optionnel). En hébergement, la plateforme injecte PORT ;
# PORT_API : port de l'API en dev local (cible du proxy Vite, avec PORT_WEB).
# PORT=3000
